# Copy to .env.local for local development (never commit .env.local).
# On Vercel, add these under Project > Settings > Environment Variables.

# Azure SQL (SQL login)
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# Login - the single allowed user, and a random secret that signs the session cookie.
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=

# Claude for the AI agent pages - ONE of the two providers:
#
# (a) Microsoft Foundry (Azure AI Foundry). The resource name is the first label of the endpoint,
#     e.g. "my-resource" for https://my-resource.services.ai.azure.com/anthropic/
#     Alternatively set ANTHROPIC_FOUNDRY_BASE_URL to the full ".../anthropic/" URL instead of the resource.
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_BASE_URL=
#
# (b) Anthropic Claude API (https://platform.claude.com/). Used only if the Foundry variables are not set.
ANTHROPIC_API_KEY=
#
# Model: defaults to claude-opus-5-5. On Foundry set this to your deployment's model name if it differs.
ANTHROPIC_MODEL=
# Reasoning effort: low | medium (default) | high | xhigh | max. Higher = longer thinking per run.
ANTHROPIC_EFFORT=

# Vercel Blob (stores backtest report PDFs). Create a Blob store in the Vercel dashboard (Storage tab),
# connect it to the project, and copy its read-write token here for local use.
BLOB_READ_WRITE_TOKEN=
# "private" (default) or "public" - must match the store's access setting
BLOB_ACCESS=private
