# Copy to .env.local for local development (never commit .env.local).
# On Vercel, add these under Project > Settings > Environment Variables.

# Azure SQL (SQL login)
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# Login - the single allowed user, and a random secret that signs the session cookie.
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=

# Claude (AI analysis pages). Create a key at https://platform.claude.com/ and keep it out of git.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5
ANTHROPIC_MODEL=
